# API
APP_ENV=development
DATABASE_URL=sqlite:///data/runtime/incidentlens.db
REDIS_URL=redis://localhost:6379/0
TASK_MODE=inline

# OpenAI-compatible model. Leave MODEL_API_KEY empty for deterministic offline replay.
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
MODEL_NAME=qwen-plus
MAX_COST_CNY=0.20

# Optional enterprise OIDC JWT federation. Values are read only when all three
# trust-boundary fields and at least one role group are configured.
STATIC_AUTH_ENABLED=true
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_GROUPS_CLAIM=groups
OIDC_RUNNER_GROUPS=[]
OIDC_ADMIN_GROUPS=[]
# Optional browser SSO (Authorization Code + PKCE). Register this exact
# callback URI at the IdP. Production endpoints and redirect must use HTTPS.
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Local example: http://localhost:3000/api/v1/auth/callback
OIDC_REDIRECT_URI=
OIDC_SCOPES=["openid","profile"]
OIDC_LOGIN_TTL_SECONDS=600
OIDC_LOGIN_RATE_LIMIT=10
OIDC_LOGIN_RATE_WINDOW_SECONDS=60
OIDC_LOGIN_MAX_OUTSTANDING=5000
OIDC_LOGIN_MAX_OUTSTANDING_PER_CLIENT=10
OIDC_SESSION_TTL_SECONDS=28800

# Demo static access. Replace or disable before exposing a live environment.
RUNNER_TOKEN=runner-demo-token
ADMIN_TOKEN=admin-demo-token
# Non-empty JSON maps replace the corresponding single-token setting and
# make audit actors distinguishable, for example {"oncall-a":"long-token"}.
RUNNER_CREDENTIALS={}
ADMIN_CREDENTIALS={}
RUNNER_DAILY_LIMIT=10
AUTH_FAILURE_LIMIT=10
AUTH_FAILURE_WINDOW_SECONDS=300
# Hard bound shared by all database-backed client rate-limit buckets.
RATE_LIMIT_MAX_RECORDS=10000
# HMAC key for privacy-preserving client rate-limit identifiers.
# In production use: python -c "import secrets; print(secrets.token_urlsafe(32))"
RATE_LIMIT_SECRET=incidentlens-development-rate-limit-secret
# Forwarded client addresses are accepted only from these proxy networks.
TRUSTED_PROXY_CIDRS=["127.0.0.0/8","::1/128"]

# Browser uses same-origin API by default. Next.js development proxies to this target.
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]

# Optional tracing profile
OTEL_EXPORTER_OTLP_ENDPOINT=
